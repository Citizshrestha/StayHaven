# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Vite build output (vite.config.js writes frontend/ -> dist/).
# Build artifacts must never be committed: they create phantom diffs on every
# build and can capture build-time env values in version control.
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - ALL .env files must be ignored
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.example.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Development logs
*.log
*.err.log
backend-dev.log
backend-dev.err.log
frontend-dev.log
frontend-dev.err.log

# Python scripts
*.py

# Windows batch files
*.bat

# PowerShell scripts
*.ps1

# Custom scripts directory
scripts/

# Documentation drafts (optional - remove if you want to commit these)
MONGODB_CONNECTION_FIX.md
NOTIFICATION_FIX_SUMMARY.md
NOTIFICATION_SOUND_IMPLEMENTATION.md
NOTIFICATION_SYSTEM_FIX_SUMMARY.md
PRODUCTION_AUDIT_REPORT.md
SESSION_SUMMARY.md
todo.md

# AI/editor tool folders (local only)
.claude/
.cursor/
.kilo/
.kombai/
.openclaude/
.orchids/
.qodo/
.sixth/

# Build caches / OS files
frontend/dist/
frontend/.vite/
desktop.ini
# Local dependency audit/cache artifacts and credentials
.npm-cache/
dependency-audit-*.json
credentials.md

# Agent QA worktrees and browser harness (local only)
.worktrees/
.qa-harness/
