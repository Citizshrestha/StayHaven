# ═══════════════════════════════════════════════════════════════════════
# StayHaven Frontend - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════
# 
# SECURITY WARNING: Never commit the actual .env file to version control!
# 
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Keep .env file secure and never share it
#
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────
# API Configuration
# ───────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────────────
# Payment Gateway Public Keys
# ⚠️ Only public/publishable keys should be in frontend
# ⚠️ Never put secret keys in frontend code!
# ───────────────────────────────────────────────────────────────────────

# Stripe Publishable Key (Get from: https://dashboard.stripe.com/test/apikeys)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_test_publishable_key

# Khalti Public Key (Get from: https://test-admin.khalti.com)
VITE_KHALTI_PUBLIC_KEY=test_public_key_your_khalti_test_key

# ───────────────────────────────────────────────────────────────────────
# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# ───────────────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ───────────────────────────────────────────────────────────────────────
# Feature Flags (Optional)
# ───────────────────────────────────────────────────────────────────────
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false

# ═══════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
