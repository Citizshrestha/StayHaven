# ---------------------------------------------------------------------------
# FRONTEND environment template (Vite)
# ---------------------------------------------------------------------------
# Copy to `frontend/.env` and fill in real values. `.env` files are gitignored;
# this template must only ever contain placeholders.
#
# WHY THIS FILE LIVES IN frontend/ AND NOT THE REPO ROOT:
# vite.config.js sets `root: './frontend'`, and Vite's `envDir` defaults to
# `root`. Vite therefore loads frontend/.env* and NEVER reads the repo-root
# .env. A VITE_* variable placed at the repo root is silently ignored.
#
# SECURITY — READ BEFORE ADDING ANY VARIABLE:
# Vite inlines every VITE_* variable into the JavaScript bundle shipped to the
# browser. Anything named VITE_* is PUBLIC and readable by any visitor. Never
# put a secret key, API secret, webhook secret or database credential here.
# Server-side payment secrets belong in Backend/.env only, and their names must
# NOT begin with VITE_.
#
# Use Stripe's PUBLISHABLE key here (pk_...), never the secret key (sk_...).
# Khalti and eSewa secret keys must never appear in this file.
#
# ENV MODE MIXING — IMPORTANT:
# For `vite build --mode production`, Vite loads `.env` FIRST and then overlays
# `.env.production`. Any key defined in `.env` but omitted from
# `.env.production` still ends up in the production bundle. A pk_test_ key left
# in `.env` will therefore ship to production unless `.env.production`
# explicitly overrides it with the pk_live_ value. Always define the full set of
# payment keys in `.env.production`, not just the ones that differ.
# ---------------------------------------------------------------------------

# Base URL of the backend server: no trailing slash, no /api suffix.
# Used for HTTP requests and as the Socket.IO fallback origin.
# Local development default when unset: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Optional. Full URL of the versioned API root. Leave unset to derive it
# automatically as ${VITE_API_BASE_URL}/api/v1, which is the normal setup.
# Only set this when the API is served from a different host or path prefix.
# VITE_API_URL=https://api.example.com/api/v1

# Optional. Socket.IO origin. Falls back to VITE_API_BASE_URL when unset.
# VITE_SOCKET_URL=http://localhost:3000

# Google OAuth Client ID for browser sign-in.
# Source: Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth 2.0 Client IDs -> Web application -> Client ID.
# Public by design; the matching client secret stays server-side.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Stripe PUBLISHABLE key, used by @stripe/stripe-js to mount Stripe Elements.
# Source: Stripe Dashboard -> Developers -> API keys -> Publishable key.
# Test mode starts with pk_test_, live mode starts with pk_live_.
# This MUST match the mode of STRIPE_SECRET_KEY in Backend/.env: mixing a
# pk_live_ browser key with an sk_test_ server key makes Stripe reject the
# PaymentIntent client secret at confirmation time, and vice versa.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# NOTE: VITE_KHALTI_PUBLIC_KEY is currently defined in frontend/.env but is not
# read anywhere in frontend/src. Khalti checkout is driven entirely server-side
# (the backend creates the pidx and returns the payment_url), so the browser
# needs no Khalti credential. Leave it out unless a client-side Khalti widget is
# actually added.
