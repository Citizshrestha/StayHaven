{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "components/*": ["components/*"],
      "context/*": ["context/*"],
      "api/*": ["api/*"],
      "utils/*": ["utils/*"],
      "shared/*": ["components/shared/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
