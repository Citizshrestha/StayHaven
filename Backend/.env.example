# ═══════════════════════════════════════════════════════════════════════
# StayHaven Backend - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════
# 
# SECURITY WARNING: Never commit the actual .env file to version control!
# 
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Keep .env file secure and never share it
# 4. Rotate all secrets regularly (every 90 days recommended)
#
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
DB_NAME=hotel-booking-system

# ───────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ───────────────────────────────────────────────────────────────────────
# JWT Configuration
# ⚠️ CRITICAL: Generate strong random secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ───────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MIN
JWT_EXPIRE=1h
JWT_ACCESS_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_DIFFERENT_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRE=7d

# ───────────────────────────────────────────────────────────────────────
# Email Configuration (SMTP)
# Get credentials from: https://www.brevo.com (formerly Sendinblue)
# ───────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM_NAME=StayHaven
SMTP_FROM_EMAIL=your_verified_email@domain.com
SENDER_EMAIL=your_verified_email@domain.com
SUPPORT_EMAIL=support@yourdomain.com

# ───────────────────────────────────────────────────────────────────────
# SMS Configuration (Choose one or multiple providers)
# ───────────────────────────────────────────────────────────────────────

# Option 1: TextBelt (FREE - No signup, limited to US/Canada)
USE_TEXTBELT=true
TEXTBELT_API_KEY=textbelt

# Option 2: Fast2SMS (India - Get from https://www.fast2sms.com)
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_SENDER_ID=TXTIND

# Option 3: MSG91 (Global - Get from https://msg91.com)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_FLOW_ID=your_msg91_flow_id
# MSG91_SENDER_ID=MSGIND

# Option 4: Twilio (Global - Get from https://www.twilio.com)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_WHATSAPP_NUMBER=+14155238886

# ───────────────────────────────────────────────────────────────────────
# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# ───────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ───────────────────────────────────────────────────────────────────────
# Cloudinary Configuration (Image Upload)
# Get from: https://cloudinary.com/console
# ───────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ───────────────────────────────────────────────────────────────────────
# Payment Gateway Configuration
# ⚠️ CRITICAL: Never use production keys in development!
# ───────────────────────────────────────────────────────────────────────

# Stripe (Get from: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key

# Khalti (Get from: https://test-admin.khalti.com or https://admin.khalti.com)
# Use test keys for development, live keys for production
KHALTI_SECRET_KEY=test_secret_key_your_khalti_test_key
KHALTI_PUBLIC_KEY=test_public_key_your_khalti_test_key

# eSewa (Get from: https://esewa.com.np)
# Test credentials for UAT environment
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST

# ───────────────────────────────────────────────────────────────────────
# GitHub Token (Optional - for GitHub integrations)
# Get from: https://github.com/settings/tokens
# ───────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=github_pat_your_personal_access_token

# ───────────────────────────────────────────────────────────────────────
# Sentry Configuration (Optional - for error monitoring)
# Get from: https://sentry.io
# ───────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ═══════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
