/* Top Header Styles */
.top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  background-color: var(--card-light);
  border-bottom: 1px solid var(--border-light);
  white-space: nowrap;
}

.dark .top-header {
  background-color: var(--card-dark);
  border-bottom-color: var(--border-dark);
}

.header-left h2 {
  color: var(--text-light);
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.25;
  margin: 0;
}

.dark .header-left h2 {
  color: var(--text-dark);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.search-container {
  position: relative;
  display: none;
}

@media (min-width: 640px) {
  .search-container {
    display: block;
  }
}

.search-icon {
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-secondary-light);
}

.dark .search-icon {
  color: var(--text-secondary-dark);
}

.search-input {
  width: 100%;
  min-width: 10rem;
  max-width: 16rem;
  border-radius: 0.5rem;
  background-color: var(--background-light);
  border: 1px solid var(--border-light);
  color: var(--text-light);
  padding: 0.625rem 0.625rem 0.625rem 2.5rem;
  height: 2.5rem;
  font-size: 0.875rem;
}

.dark .search-input {
  background-color: var(--background-dark);
  border-color: var(--border-dark);
  color: var(--text-dark);
}

.search-input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.1);
}

.icon-button {
  position: relative;
  display: flex;
  cursor: pointer;
  align-items: center;
  justify-content: center;
  border-radius: 0.5rem;
  height: 2.5rem;
  width: 2.5rem;
  background: transparent;
  border: none;
  color: var(--text-secondary-light);
  transition: all 0.3s;
}

.dark .icon-button {
  color: var(--text-secondary-dark);
}

.icon-button:hover {
  background-color: rgba(20, 184, 166, 0.1);
  color: var(--primary);
}

.dark .icon-button:hover {
  background-color: rgba(255, 255, 255, 0.1);
}

.notification-dot {
  position: absolute;
  top: 0.375rem;
  right: 0.375rem;
  height: 0.5rem;
  width: 0.5rem;
  border-radius: 50%;
  background-color: var(--error);
  box-shadow: 0 0 0 2px var(--card-light);
}

.dark .notification-dot {
  box-shadow: 0 0 0 2px var(--card-dark);
}

.user-avatar {
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  border-radius: 50%;
  width: 2.5rem;
  height: 2.5rem;
  aspect-ratio: 1;
}

/* Page Content Styles */
.page-content {
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 640px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .stats-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  border-radius: 0.75rem;
  padding: 1.5rem;
  background-color: var(--card-light);
  border: 1px solid var(--border-light);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.dark .stat-card {
  background-color: var(--card-dark);
  border-color: var(--border-dark);
}

.stat-label {
  color: var(--text-secondary-light);
  font-size: 0.875rem;
  font-weight: 500;
  margin: 0;
}

.dark .stat-label {
  color: var(--text-secondary-dark);
}

.stat-value {
  color: var(--text-light);
  font-size: 1.875rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 2.25rem;
  margin: 0;
}

.dark .stat-value {
  color: var(--text-dark);
}

.stat-trend {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 500;
  margin: 0;
}

.stat-trend.success {
  color: var(--success);
}

.stat-trend.error {
  color: var(--error);
}

.stat-trend.warning {
  color: var(--warning);
}

/* Charts Grid */
.charts-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 1024px) {
  .charts-grid {
    grid-template-columns: 3fr 2fr;
  }
}

.chart-card {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border-light);
  padding: 1.5rem;
  background-color: var(--card-light);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.dark .chart-card {
  background-color: var(--card-dark);
  border-color: var(--border-dark);
}

.chart-title {
  color: var(--text-light);
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
}

.dark .chart-title {
  color: var(--text-dark);
}

.chart-header {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
}

.chart-value {
  color: var(--text-light);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 2.25rem;
  margin: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dark .chart-value {
  color: var(--text-dark);
}

.chart-trend {
  display: flex;
  align-items: center;
  font-size: 0.875rem;
  font-weight: 500;
  margin: 0;
}

.chart-trend.success {
  color: var(--success);
}

.chart-subtitle {
  color: var(--text-secondary-light);
  font-size: 0.875rem;
  margin: 0;
}

.dark .chart-subtitle {
  color: var(--text-secondary-dark);
}

.chart-container {
  display: flex;
  min-height: 220px;
  flex: 1;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1rem 0;
}

.booking-chart {
  width: 100%;
  fill: none;
}

.revenue-bars {
  display: flex;
  flex-direction: column;
  min-height: 220px;
  flex: 1;
  justify-content: center;
  gap: 1rem;
  padding: 1rem 0;
}

.revenue-bar {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.bar-label {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-secondary-light);
  width: 5rem;
  text-align: right;
  margin: 0;
}

.dark .bar-label {
  color: var(--text-secondary-dark);
}

.bar-container {
  width: 100%;
  background-color: var(--background-light);
  border-radius: 9999px;
  height: 0.625rem;
}

.dark .bar-container {
  background-color: var(--background-dark);
}

.bar-fill {
  background-color: var(--primary);
  height: 0.625rem;
  border-radius: 9999px;
  transition: width 0.3s ease;
}

/* Table Styles */
.table-card {
  background-color: var(--card-light);
  border-radius: 0.75rem;
  border: 1px solid var(--border-light);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.dark .table-card {
  background-color: var(--card-dark);
  border-color: var(--border-dark);
}

.table-title {
  color: var(--text-light);
  font-size: 1.125rem;
  font-weight: 700;
  padding: 1.5rem;
  margin: 0;
}

.dark .table-title {
  color: var(--text-dark);
}

.table-container {
  overflow-x: auto;
}

.bookings-table {
  width: 100%;
  font-size: 0.875rem;
  text-align: left;
}

.bookings-table thead {
  font-size: 0.75rem;
  color: var(--text-secondary-light);
  text-transform: uppercase;
  background-color: var(--background-light);
}

.dark .bookings-table thead {
  color: var(--text-secondary-dark);
  background-color: var(--background-dark);
}

.bookings-table th {
  padding: 0.75rem 1.5rem;
  font-weight: 500;
}

.bookings-table tbody tr {
  border-bottom: 1px solid var(--border-light);
  transition: background-color 0.3s;
}

.dark .bookings-table tbody tr {
  border-bottom-color: var(--border-dark);
}

.bookings-table tbody tr:hover {
  background-color: rgba(20, 184, 166, 0.05);
}

.dark .bookings-table tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.05);
}

.bookings-table td {
  padding: 1rem 1.5rem;
}

.guest-name {
  font-weight: 500;
  color: var(--text-light);
}

.dark .guest-name {
  color: var(--text-dark);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  font-size: 0.75rem;
  font-weight: 500;
  padding: 0.125rem 0.625rem;
  border-radius: 9999px;
}

.status-badge.success {
  background-color: rgba(16, 185, 129, 0.1);
  color: var(--success);
}

.status-badge.warning {
  background-color: rgba(245, 158, 11, 0.1);
  color: var(--warning);
}

.status-badge.error {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--error);
}

.view-button {
  font-weight: 500;
  color: var(--primary);
  background: none;
  border: none;
  cursor: pointer;
  transition: color 0.3s;
}

.view-button:hover {
  text-decoration: underline;
}

/* Responsive Design */
@media (max-width: 768px) {
  .page-content {
    padding: 1rem;
  }
  
  .top-header {
    padding: 1rem;
  }
  
  .header-right {
    gap: 0.5rem;
  }
}