{
  "compilerOptions": {
    "baseUrl": "frontend/src",
    "paths": {
      "@/*": ["./*"],
      "components/*": ["components/*"],
      "context/*": ["context/*"],
      "api/*": ["api/*"],
      "utils/*": ["utils/*"],
      "shared/*": ["components/shared/*"]
    }
  },
  "include": ["frontend/src"],
  "exclude": ["node_modules", "Backend", "dist"]
}
