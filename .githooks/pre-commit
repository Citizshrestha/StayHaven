#!/bin/sh
#
# Pre-commit hook to prevent committing sensitive files
# 
# Installation:
#   chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Files to check
SENSITIVE_FILES=".env .env.local .env.development .env.production Backend/.env frontend/.env"

# Check if any sensitive files are being committed
for file in $SENSITIVE_FILES; do
    if git diff --cached --name-only | grep -q "^$file$"; then
        echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo "${RED}🚨 COMMIT BLOCKED - SECURITY VIOLATION 🚨${NC}"
        echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo "${YELLOW}You are attempting to commit: $file${NC}"
        echo ""
        echo "This file contains sensitive credentials and should NEVER be committed!"
        echo ""
        echo "To fix this:"
        echo "  1. Remove the file from staging:"
        echo "     ${YELLOW}git reset HEAD $file${NC}"
        echo ""
        echo "  2. Ensure .gitignore includes:"
        echo "     ${YELLOW}.env${NC}"
        echo "     ${YELLOW}.env.local${NC}"
        echo "     ${YELLOW}Backend/.env${NC}"
        echo "     ${YELLOW}frontend/.env${NC}"
        echo ""
        echo "  3. Use .env.example files instead for templates"
        echo ""
        echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        exit 1
    fi
done

# Check for potential secrets in code
if git diff --cached | grep -iE "(password|secret|api_key|apikey|token|private_key).*=.*['\"][^'\"]{20,}['\"]"; then
    echo "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo "${YELLOW}⚠️  WARNING - POTENTIAL SECRET DETECTED ⚠️${NC}"
    echo "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Detected what appears to be a hardcoded secret in your code."
    echo ""
    echo "Please verify that you are not committing:"
    echo "  - API keys"
    echo "  - Passwords"
    echo "  - Tokens"
    echo "  - Private keys"
    echo ""
    echo "If this is a false positive, you can proceed."
    echo "Otherwise, use environment variables instead!"
    echo ""
    read -p "Do you want to proceed anyway? (yes/no): " response
    if [ "$response" != "yes" ]; then
        echo "${RED}Commit aborted.${NC}"
        exit 1
    fi
fi

# All checks passed
echo "${NC}✅ Pre-commit checks passed${NC}"
exit 0
