#!/bin/sh
#
# Pre-commit hook: prevent committing credentials, especially payment secrets.
#
# INSTALLATION (must be done once per clone - hooks are not shared by git):
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-commit
#
# Verify it is active with:  git config core.hooksPath   ->  .githooks
#
# Bypass for a single commit (use only when you are certain):
#   git commit --no-verify
#

RED=$(printf '\033[0;31m')
YELLOW=$(printf '\033[1;33m')
NC=$(printf '\033[0m')

RULE="============================================================"

fail() {
    printf '%s%s%s\n' "$RED" "$RULE" "$NC"
    printf '%sCOMMIT BLOCKED - SECURITY VIOLATION%s\n' "$RED" "$NC"
    printf '%s%s%s\n\n' "$RED" "$RULE" "$NC"
}

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

# ---------------------------------------------------------------------------
# 1. Block real .env files. Pattern-based so new variants are covered too
#    (.env.production, Backend/.env.local, frontend/.env.staging, ...).
#    Templates (.env.example, .env.example.*) are explicitly allowed.
# ---------------------------------------------------------------------------
ENV_HITS=$(printf '%s\n' "$STAGED" \
    | grep -E '(^|/)\.env($|\.)' \
    | grep -vE '\.example($|\.)')

if [ -n "$ENV_HITS" ]; then
    fail
    printf '%sYou are attempting to commit environment file(s):%s\n\n' "$YELLOW" "$NC"
    printf '%s\n' "$ENV_HITS" | sed 's/^/    /'
    printf '\nThese hold live credentials (database URI, JWT secret, Stripe/Khalti/eSewa\n'
    printf 'secret keys) and must never enter git history - history survives deletion.\n\n'
    printf 'To fix:\n'
    printf '  1. Unstage:  %sgit restore --staged <file>%s\n' "$YELLOW" "$NC"
    printf '  2. Keep the real values only in your local, gitignored .env\n'
    printf '  3. Document the KEY NAMES (never values) in the matching .env.example\n\n'
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. Block live/real payment provider keys in staged content.
#    Length-based matching so documentation placeholders such as
#    sk_live_YOUR_LIVE_KEY or live_secret_key_YOUR_KEY do not trip this.
# ---------------------------------------------------------------------------
STAGED_DIFF=$(git diff --cached --diff-filter=ACM 2>/dev/null)

PAYMENT_HITS=$(printf '%s' "$STAGED_DIFF" \
    | grep -nE '(sk_live_[A-Za-z0-9]{20,}|rk_live_[A-Za-z0-9]{20,}|whsec_[A-Za-z0-9]{24,}|live_secret_key_[0-9a-f]{24,})' \
    | cut -c1-80)

if [ -n "$PAYMENT_HITS" ]; then
    fail
    printf '%sA live payment credential appears in staged content.%s\n\n' "$YELLOW" "$NC"
    printf 'Matched near (truncated, values not shown in full):\n'
    printf '%s\n' "$PAYMENT_HITS" | sed 's/^/    /'
    printf '\nLive secret keys can move real money. If this key was ever committed,\n'
    printf 'ROTATE IT in the provider dashboard - removing the commit is not enough.\n\n'
    printf 'Server-side secrets belong in Backend/.env only, never in tracked files\n'
    printf 'and never in any VITE_* variable (those are inlined into the browser bundle).\n\n'
    exit 1
fi

# ---------------------------------------------------------------------------
# 3. Warn on generic hardcoded-secret patterns. Interactive confirmation when a
#    terminal is available; otherwise fail closed rather than silently passing.
# ---------------------------------------------------------------------------
GENERIC_HITS=$(printf '%s' "$STAGED_DIFF" \
    | grep -vE '^[-+]{3}' \
    | grep -iE '^\+.*(password|secret|api_key|apikey|token|private_key)[a-z_]*[[:space:]]*[:=][[:space:]]*.?["\x27][^"\x27]{20,}["\x27]' \
    | grep -viE '(example|placeholder|your[-_]|xxx|changeme|dummy|sample|redacted|process\.env|import\.meta\.env)' \
    | cut -c1-80)

if [ -n "$GENERIC_HITS" ]; then
    printf '%s%s%s\n' "$YELLOW" "$RULE" "$NC"
    printf '%sWARNING - POTENTIAL HARDCODED SECRET%s\n' "$YELLOW" "$NC"
    printf '%s%s%s\n\n' "$YELLOW" "$RULE" "$NC"
    printf 'Added line(s) look like an inline credential (truncated):\n'
    printf '%s\n' "$GENERIC_HITS" | sed 's/^/    /'
    printf '\nPrefer reading the value from an environment variable.\n\n'

    if [ -t 0 ] || [ -e /dev/tty ]; then
        printf 'Proceed anyway? (yes/no): '
        read response < /dev/tty 2>/dev/null || response=""
        if [ "$response" != "yes" ]; then
            printf '%sCommit aborted.%s\n' "$RED" "$NC"
            exit 1
        fi
    else
        printf '%sNo terminal available to confirm; blocking to fail safe.%s\n' "$RED" "$NC"
        printf 'Re-run interactively, or use %sgit commit --no-verify%s if this is a false positive.\n' "$YELLOW" "$NC"
        exit 1
    fi
fi

printf 'Pre-commit checks passed\n'
exit 0
