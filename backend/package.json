{
  "name": "stayhaven-backend",
  "version": "1.0.0",
  "description": "StayHaven Backend API Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:pricing": "node --test --test-concurrency=1 tests/orderPricing.integration.test.js",
    "test:requests": "node --test --test-concurrency=1 tests/roomRequests.integration.test.js",
    "test:unit": "node --test tests/demoSeedSafety.test.js tests/paymentGateway.test.js tests/diningBilling.test.js",
    "test:dining": "node --test --test-concurrency=1 tests/diningBilling.test.js tests/dining.integration.test.js",
    "test:gateway": "node --test tests/paymentGateway.test.js",
    "test:safety": "node --test tests/demoSeedSafety.test.js",
    "test:wallet": "node --test --test-concurrency=1 tests/walletPayments.integration.test.js",
    "test:banktransfer": "node --test --test-concurrency=1 tests/bankTransfer.integration.test.js",
    "test:card": "node --test --test-concurrency=1 tests/cardPayment.integration.test.js",
    "test:staff": "node --test --test-concurrency=1 tests/staffManagement.integration.test.js",
    "test:superadmin": "node --test --test-concurrency=1 tests/superadmin.integration.test.js",
    "test:platform": "node --test --test-concurrency=1 tests/platformAuth.integration.test.js tests/orderAccess.integration.test.js tests/routePolicy.test.js tests/finalPass.integration.test.js tests/uploadErrors.test.js"
  },
  "keywords": [
    "hotel",
    "booking",
    "hospitality",
    "management"
  ],
  "author": "StayHaven Team",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@sentry/node": "^11.4.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.4.1",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.15",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.0",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
