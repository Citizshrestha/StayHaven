# ═══════════════════════════════════════════════════════════════════════
# StayHaven Backend - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════
# 
# SECURITY WARNING: Never commit the actual .env file to version control!
# 
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Keep .env file secure and never share it
# 4. Rotate all secrets regularly (every 90 days recommended)
#
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
DB_NAME=hotel-booking-system

# ───────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ───────────────────────────────────────────────────────────────────────
# JWT Configuration
# ⚠️ CRITICAL: Generate strong random secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ───────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MIN
JWT_EXPIRE=1h
JWT_ACCESS_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_DIFFERENT_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRE=7d

# ───────────────────────────────────────────────────────────────────────
# Rate Limiting (optional)
# If set, rate limiters use a shared Redis store instead of in-memory
# counters — required for correct rate limiting across multiple server
# instances / after restarts. Leave unset to keep the current in-memory
# behavior (fine for a single dev instance).
# ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ───────────────────────────────────────────────────────────────────────
# Demo / Sample Data Seeding (DANGEROUS - strict opt-in)
#
# When enabled, the server writes DEMO hotels, bookings, guests, payouts,
# refunds, transactions and reviews into whatever database MONGODB_URI points
# at, automatically, on every boot.
#
# Leave this UNSET unless MONGODB_URI points at a disposable database you are
# happy to pollute. It is deliberately opt-in: "not production" is NOT a safe
# signal, because NODE_ENV is unset in most local shells and developer .env
# files here point at a live Atlas cluster.
#
# Only the exact string "true" enables it. Production refuses to seed even if
# this is accidentally set to true.
# ───────────────────────────────────────────────────────────────────────
# ENABLE_DEMO_SEED=true

# Absolute kill switch. If set to "false" seeding never runs, regardless of
# ENABLE_DEMO_SEED. Useful to hard-disable seeding for a whole environment.
# AUTO_SEED_DEMO=false

# ───────────────────────────────────────────────────────────────────────
# Superadmin Bootstrap (optional)
# If both are set, server.js seeds this superadmin account on first boot
# if it doesn't already exist. Leave unset to skip seeding entirely.
# ───────────────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=superadmin@yourdomain.com
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

# ───────────────────────────────────────────────────────────────────────
# Email Configuration (SMTP)
# Get credentials from: https://www.brevo.com (formerly Sendinblue)
# IMPORTANT: Use ONLY a Brevo-verified sender email (check your Brevo dashboard).
# If you use Gmail/Yahoo/etc., their DMARC policy will reject mail sent through Brevo.
# ───────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM_NAME=StayHaven
SMTP_FROM_EMAIL=noreply@yourdomain.com
SENDER_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ───────────────────────────────────────────────────────────────────────
# SMS Configuration (Choose one or multiple providers)
# ───────────────────────────────────────────────────────────────────────

# Option 1: TextBelt (FREE - No signup, limited to US/Canada)
USE_TEXTBELT=true
TEXTBELT_API_KEY=textbelt

# Option 2: Fast2SMS (India - Get from https://www.fast2sms.com)
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_SENDER_ID=TXTIND

# Option 3: MSG91 (Global - Get from https://msg91.com)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_FLOW_ID=your_msg91_flow_id
# MSG91_SENDER_ID=MSGIND

# Option 4: Twilio (Global - Get from https://www.twilio.com)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_WHATSAPP_NUMBER=+14155238886

# ───────────────────────────────────────────────────────────────────────
# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# ───────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ───────────────────────────────────────────────────────────────────────
# Cloudinary Configuration (Image Upload)
# Get from: https://cloudinary.com/console
# ───────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ───────────────────────────────────────────────────────────────────────
# Payment Gateway Configuration
# ⚠️ CRITICAL: Never use production keys in development!
# ───────────────────────────────────────────────────────────────────────

# Stripe (Get from: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key

# Wallet callback URLs must be public HTTPS in production. Configure the two
# explicit gateway environments independently; secrets are server-only.
PAYMENT_SERVER_URL=https://api.example.com
PAYMENT_CLIENT_URL=https://app.example.com

# Khalti (https://test-admin.khalti.com or https://admin.khalti.com)
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=replace_with_khalti_sandbox_secret

# eSewa (https://developer.esewa.com.np/pages/Epay)
# UAT/test environment: eSewa's publicly-documented sandbox secret key is
# "8gBm/:&EnhH.1/q" with product code "EPAYTEST" (see their integration
# docs) — use a real key from your merchant dashboard for production.
ESEWA_ENV=sandbox
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST

# ───────────────────────────────────────────────────────────────────────
# GitHub Token (Optional - for GitHub integrations)
# Get from: https://github.com/settings/tokens
# ───────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=github_pat_your_personal_access_token

# ───────────────────────────────────────────────────────────────────────
# Sentry Configuration (Optional - for error monitoring)
# Get from: https://sentry.io
# ───────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ═══════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Exact number of trusted reverse-proxy hops (0 = direct connection).
# Set to 1 only when every request traverses exactly one trusted proxy.
TRUST_PROXY_HOPS=0
